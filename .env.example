# Server: Apple Music account history (also required by the local CLI).
AM_DEV_TOKEN=
AM_USER_TOKEN=

# Server only: existing Redis connection.
REDIS_URL=

# Set the same random secret (at least 32 characters) on the server and locally.
# Generate one with: openssl rand -hex 32
MUSIC_SYNC_SECRET=

# CLI only: deploy the new endpoint before pointing this at production.
MUSIC_SYNC_URL=https://matteing.com/api/now-playing
# For local development: http://localhost:3000/api/now-playing
